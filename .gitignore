# Environment variables
.env
.env.local
# The file scripts/push_secrets.py reads. It holds real values on the way to
# the secret manager, and must never be the thing that puts them in git.
secrets.env
secrets*.env
*.secrets.env
.env.*.local

# Python / FastAPI
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.ruff_cache/
*.pyc

# Node.js / Next.js
node_modules/
test-results/
playwright-report/
.next/
out/
dist/
*.tsbuildinfo
.eslintcache
npm-debug.log*

# Storage / Database runtime files.
# Unanchored, because the app writes these under backend/storage while the
# tooling that made these rules ran from the repository root — a leading path
# would quietly let a customer's uploaded CSV into a commit.
**/storage/dev.db*
# Scratch database from a local run of the end-to-end job.
.e2e-storage/
# Redis writes its snapshot into whatever directory it was started from, so
# running the broker for tests/test_worker_roundtrip.py leaves one at the
# repository root.
dump.rdb
**/storage/uploads/*
!**/storage/uploads/.gitkeep
**/storage/parquet/*
!**/storage/parquet/.gitkeep
**/storage/exports/*
!**/storage/exports/.gitkeep

# IDEs & System
.vscode/
.idea/
.DS_Store
*.log

# Stray archives
*.zip

# Screenshots written by the browser audits.
frontend/audits/out-*.png
