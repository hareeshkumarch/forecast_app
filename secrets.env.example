# Fill in, save as secrets.env, then:
#   python3 scripts/push_secrets.py secrets.env --dry-run
#   python3 scripts/push_secrets.py secrets.env
#
# secrets.env is gitignored. This example file is not, so it holds no values.

# ---- sign-in -------------------------------------------------------------
AUTH_ENABLED=false
SUPABASE_URL=https://qfkztfdpchfhfyqqtyki.supabase.co
# Only if the Supabase project signs its tokens with HS256. Settings -> API ->
# JWT Settings. Newer projects publish a key set instead and need nothing here.
SUPABASE_JWT_SECRET=

# ---- who may sign in, and who approves them ------------------------------
AUTH_REQUIRE_APPROVAL=true
AUTH_ADMIN_EMAILS=
# Empty means any Google account may ask. A domain here means only that domain.
AUTH_ALLOWED_EMAIL_DOMAINS=
# Where the approve/reject links in the email point. The Vercel address rather
# than the EC2 one on purpose: Vercel already proxies /api to the backend, so
# the link an administrator taps is HTTPS the whole way. Pointing it at the raw
# EC2 host would put an approval token in a plain-HTTP URL.
PUBLIC_API_BASE_URL=https://forecast-app-hazel.vercel.app

# ---- approval email ------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# A Gmail app password, 16 characters, no spaces.
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
