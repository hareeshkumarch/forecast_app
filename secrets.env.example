# Everything the backend reads, in one file.
#
# Two ways in, both fine:
#
#   1. Paste it. Infisical -> your project -> prod -> Add Secret -> the
#      "Import from .env" / drag-and-drop box takes these lines as they are.
#   2. Push it:
#        cp secrets.env.example secrets.env     # then fill the blanks
#        python3 scripts/push_secrets.py --check
#        python3 scripts/push_secrets.py secrets.env
#
# secrets.env is gitignored. This example file is not, so it holds no values.
# The script refuses to push a placeholder, so a half-filled file fails loudly
# here rather than quietly at 3am in a container.
#
# The four INFISICAL_* variables are NOT in this list and must not be. They
# are the credential that opens Infisical, so they stay in /opt/forecast/.env
# on the instance. Everything below moves in here.

# ---- where the data lives -------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> URI.
# The pooled host is fine; the platform detects it and turns off server-side
# statement caching, which pgbouncer in transaction mode cannot carry.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_DB_URL=
DATABASE_FALLBACK_ENABLED=false

# ---- archiving the uploads ------------------------------------------------
# An upload is the customer's original spreadsheet and the only artifact that
# cannot be rebuilt. Leave STORAGE_BUCKET empty and the copy is skipped.
# Keys from Supabase -> Project Settings -> Storage -> S3 access keys.
STORAGE_BUCKET=file
STORAGE_ENDPOINT=https://YOUR-PROJECT-REF.storage.supabase.co/storage/v1/s3
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ---- the key everything else is encrypted with ----------------------------
# openssl rand -hex 32
# Every stored connector credential is encrypted with this. Changing it later
# does not re-encrypt them, it makes them undecryptable. Set it once.
CREDENTIAL_SECRET_KEY=

# ---- sign-in --------------------------------------------------------------
AUTH_ENABLED=true
AUTH_REQUIRE_APPROVAL=true
# Told when somebody new asks, may approve them, and approved on sight.
AUTH_ADMIN_EMAILS=
# Empty means any Google account may ask. A domain here admits only it.
AUTH_ALLOWED_EMAIL_DOMAINS=
# Individual addresses admitted whatever the domain rule says.
AUTH_ALLOWLIST=
# Required when the Supabase project signs with HS256 — which yours does.
# Supabase -> Project Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=
# Where the approve/reject links in the email point. The Vercel address, not
# the EC2 one: Vercel already proxies /api to the backend, so the link an
# administrator taps is HTTPS end to end. The raw EC2 host would put an
# approval token in a plain-HTTP URL.
PUBLIC_API_BASE_URL=https://YOUR-SITE.vercel.app

# ---- outbound email -------------------------------------------------------
# Plain SMTP, so a free Gmail app password works and so does Brevo or Resend.
# A Gmail app password is 16 characters with the spaces removed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---- metrics ---------------------------------------------------------------
# The bearer token a Prometheus scrape must present to read
# /api/health/metrics. This deployment is production, so leaving it empty
# means every scrape is refused — the endpoint describes every route served
# and how often each one fails, which is not something to hand out by
# accident. Generate one with `openssl rand -hex 32`.
METRICS_TOKEN=

# ---- runtime --------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
# These two multiply. On a two-core box only one may be above 1, or the
# processes contend for cores and everything gets slower. One run at a time
# using both cores is the faster arrangement for a single team: the person
# waiting sees their own run finish sooner.
FORECAST_WORKERS=1
FORECAST_CANDIDATE_WORKERS=2
RUN_SEED_ON_STARTUP=false
# The browser origins allowed to call the API. Comma separated.
CORS_ORIGINS=https://YOUR-SITE.vercel.app
