# Copy to .env before running `docker compose up --build`.
# Every value below has a working default in docker-compose.yml, so an empty
# .env still boots — override only what you need.

# ------------------------------------------------------- Supabase (primary)
# Supabase is the store of record: connectors, datasets, forecast runs, series
# and insights are all written there. Leave these empty and the platform uses
# the local PostgreSQL below instead — nothing else needs changing.
#
# Either paste the connection string from Supabase (Project Settings →
# Database → Connection string → URI):
# SUPABASE_DB_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
#
# …or give the project URL and the database password and let the host be
# derived from the project ref:
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_DB_PASSWORD=

# The pooled host (…pooler.supabase.com:6543) works too — it is detected and
# statement caching is turned off for it, because pgbouncer cannot hold it.

# The API falls back to the local PostgreSQL when Supabase is unreachable at
# boot. Set this false to fail the boot instead, so rows never quietly land on
# a node nobody reads from.
DATABASE_FALLBACK_ENABLED=true

# ---------------------------------------------------- PostgreSQL (fallback)
POSTGRES_USER=forecasting
POSTGRES_PASSWORD=forecasting
POSTGRES_DB=forecasting
POSTGRES_PORT=5432

# ------------------------------------------------------------------- Backend
BACKEND_PORT=8000

# Production mode fails fast when database fallback is enabled, the credential
# key is weak/default, or CORS allows every origin.
APP_ENV=development

# The fallback store, used when Supabase is unset or unreachable.
# Async driver (asyncpg) — used by the FastAPI request path.
DATABASE_URL=postgresql+asyncpg://forecasting:forecasting@postgres:5432/forecasting
# Sync driver (psycopg) — used by Alembic migrations only.
SYNC_DATABASE_URL=postgresql+psycopg://forecasting:forecasting@postgres:5432/forecasting

# Root for uploads/, parquet/ and exports/.
STORAGE_ROOT=/storage

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Fernet-style symmetric key used to encrypt connector credentials at rest.
CREDENTIAL_SECRET_KEY=dev-only-insecure-key-change-me

# Hard ceiling for uploaded datasets. 20 MB, per the POC constraint.
MAX_UPLOAD_BYTES=20971520

# Size of the ProcessPoolExecutor that runs CPU-bound model training.
FORECAST_WORKERS=2
# Candidate models evaluated at the same time inside one forecast run.
# Keep FORECAST_WORKERS × FORECAST_MODEL_CONCURRENCY near the available CPU cores.
FORECAST_MODEL_CONCURRENCY=2

# Seed demo connectors + sample dataset + a completed forecast run on boot.
RUN_SEED_ON_STARTUP=true

LOG_LEVEL=INFO
# `text` reads well in a terminal; `json` is one object per line for log shippers.
LOG_FORMAT=text

# ------------------------------------------------------------------ Frontend
FRONTEND_PORT=3000
# Origin the *browser* uses to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ----------------------------------------------- Multi-Provider LLM Rewriter
# Supported LLM_PROVIDER options: openai | anthropic | groq | xai | gemini | openrouter | custom
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Provider Models Reference:
# - OpenAI: gpt-4o-mini | gpt-4o | o3-mini
# - Anthropic: claude-3-5-sonnet-20241022 | claude-3-5-haiku-20241022
# - Groq: llama-3.3-70b-versatile | deepseek-r1-distill-llama-70b
# - xAI / Grok: grok-2-latest | grok-beta (https://api.x.ai/v1)
# - Gemini: gemini-2.5-flash | gemini-2.5-pro (https://generativelanguage.googleapis.com/v1beta/openai/)

# ------------------------------------------------------- Distributed workers
# Set a broker to run forecasts on Celery workers. Left empty the API fits
# models in an in-process pool, which is right for a single node.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Carries live progress from a worker to whichever API serves the SSE stream.
REDIS_URL=redis://redis:6379/2
REDIS_PORT=6379
WORKER_CONCURRENCY=2

# =============================================================================
# Forecasting internals
#
# Everything below has a working default and can be left out entirely. They are
# listed because they are the knobs that change what the platform *decides*,
# not just how it is wired. Every one is range-checked at boot: a value outside
# its range fails the start with a message naming it, rather than quietly
# producing a forecast nobody can explain.
# =============================================================================

# --------------------------------------------------------- Model selection
# Backtest folds per run. More folds is a steadier estimate and a slower run.
FORECAST_MAX_FOLDS=5

# How the error metrics are weighed against each other when the winner is
# picked. Relative to one another, so they need not sum to 1 — but they cannot
# all be zero, because then nothing ranks the candidates.
#
# MASE rather than sMAPE. sMAPE is undefined wherever an actual and its
# forecast are both zero, so on intermittent demand it scores only the periods
# that happened to have sales and ranks candidates on that slice. It is still
# reported; it is not allowed to decide.
METRIC_WEIGHT_WMAPE=0.50
METRIC_WEIGHT_MASE=0.30
METRIC_WEIGHT_RMSE=0.20

# What a candidate's interval quality (Winkler score) is worth beside its point
# error. Raise it to prefer models whose bands are honest over models whose
# centre line is marginally closer.
INTERVAL_WEIGHT=0.15

# --------------------------------------------------- Model hyperparameters
SARIMAX_ORDER_P=1
SARIMAX_ORDER_D=1
SARIMAX_ORDER_Q=1
GBM_MAX_DEPTH=3
GBM_LEARNING_RATE=0.06
# Training rows a design matrix needs after lags before GBM is worth trying.
MIN_GBM_ROWS=8

# ---------------------------------------------------- Search and ensembling
# Ceiling on hyperparameter evaluations per model, and the smallest validation
# block a fold may use.
TUNING_MAX_EVALUATIONS=24
TUNING_MIN_VALIDATION_ROWS=6

# Blends are capped at this many members, and are only kept when they beat
# their best single member by at least this fraction (0.02 = 2%).
ENSEMBLE_MAX_MEMBERS=4
ENSEMBLE_MIN_IMPROVEMENT=0.02

# How far a backtest prediction may wander from the level it was trained on
# before it is called divergent and discarded. Lower catches more runaway fits
# and risks discarding a real regime change.
DIVERGENCE_SIGMAS=12.0

# -------------------------------------------------------- Forecast defaults
# The horizon a dataset gets when nobody picks one, by detected frequency.
DEFAULT_HORIZON_DAILY=30
DEFAULT_HORIZON_WEEKLY=13
DEFAULT_HORIZON_MONTHLY=6
DEFAULT_HORIZON_QUARTERLY=4

# The band best/worst case quote. Distinct from a run's own confidence level,
# which sets the interval shown around the line.
SCENARIO_CONFIDENCE=0.95

# The calendar month a fiscal year starts in. An ERP writing FY24-P01 means the
# first period of its own year, not January: 10 for a US federal calendar, 4 for an
# Indian or UK one, 2 for many retailers. Default 1.
FISCAL_YEAR_START_MONTH=1

# ------------------------------------------------------------- LLM rewriter
LLM_MAX_TOKENS=400
LLM_TIMEOUT_SECONDS=10.0
LLM_TEMPERATURE=0.2
# Insights rewritten in parallel per run.
LLM_MAX_CONCURRENT_REWRITES=8
# Consecutive *transport* failures — timeouts, refused connections, 429, 5xx —
# before calls to a provider are paused. A 401 or a 404 is an answer, not an
# outage, and deliberately does not count: somebody who has just corrected a
# key should not wait out a cooldown to find out it works.
LLM_BREAKER_FAILURE_THRESHOLD=4
# How long calls stay paused before one trial is let through. Pressing "check
# the key" on the insights screen is also a trial, and a successful one closes
# the circuit for the rewrite path too.
LLM_BREAKER_RESET_SECONDS=30.0

# --------------------------------------------------------- Insight thresholds
# Below this backtested accuracy, insights say the period figures are only
# directional; below the plannable line they stop treating them as plannable.
INSIGHT_ACCURACY_WARNING=80.0
INSIGHT_ACCURACY_PLANNABLE=75.0
# Standard deviations from fit before a period is called an anomaly.
INSIGHT_ANOMALY_Z_THRESHOLD=2.5
# Downside percentage at which worst-case risk is raised to critical.
INSIGHT_DOWNSIDE_SEVERE_PCT=15.0

# ----------------------------------------------------------------------- Drift
# Once a run has been scored against what actually happened, these decide when
# it is called drifted rather than merely noisy. The tracking signal is the
# cumulative error in mean absolute deviations — near zero the misses cancel
# out, and 4 is the classic Trigg limit.
DRIFT_TRACKING_SIGNAL_LIMIT=4.0
# Realized wMAPE past which a run is drifted whichever way its bias runs.
DRIFT_WMAPE_LIMIT=50.0

# ------------------------------------------------------------ API and fan-out
# Leaves dispatched per chunk when a grouped run fans out to workers.
SERIES_FAN_OUT_CHUNK=10
# Rows the LLM usage summary reads back per window.
USAGE_EVENTS_LIMIT=5000
# Hard ceiling on ?limit= for the paged list endpoints.
API_MAX_PAGE_SIZE=200

# --------------------------------------------------------------- Load shedding
# Requests this process will have in flight before it answers 503 instead of
# queueing. A ceiling is not a speed limit — it is what stops a burst becoming
# a queue of answers nobody is still waiting for. Health checks and the
# progress streams are exempt: the first is how the load balancer decides this
# instance is alive, and the second is open for the length of a forecast run.
MAX_CONCURRENT_REQUESTS=64
# Off for a load test that wants to find the real ceiling, never for a
# deployment facing the internet.
LOAD_SHEDDING_ENABLED=true

# ------------------------------------------------------------------- Versioning
# What the API advertises as its version, and what is mixed into every cache
# validator. Set this to the build id on deploy and each release invalidates
# clients' stored copies exactly once — which is the only signal there is for
# a change that keeps a response's shape and alters a number inside it.
APP_VERSION=0.1.0

# --------------------------------------------------------------------- Metrics
# Serves /api/health/metrics in Prometheus' text exposition format: request
# rates and latency histograms per route template, cache hit ratios, circuit
# breaker states, forecast run outcomes and durations.
METRICS_ENABLED=true
# The bearer token a scraper must present. In production, leaving this empty
# means every scrape is refused: the endpoint describes every route this
# deployment serves and how often each one fails, which is not something to
# serve openly by accident. Outside production it is optional and the endpoint
# is open.
METRICS_TOKEN=

# ------------------------------------------------------ Dashboard read cache
# Dashboard aggregates are cached in-process under a key that contains the
# run's own revision, so an entry cannot be served stale — only unused. These
# three are memory knobs, not correctness knobs.
DASHBOARD_CACHE_ENABLED=true
DASHBOARD_CACHE_TTL_SECONDS=300
DASHBOARD_CACHE_MAX_ENTRIES=600
