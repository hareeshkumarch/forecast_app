# Template for /opt/forecast/.env on the instance.
#
#   cp deploy/aws/env.production.example /opt/forecast/.env
#   chmod 600 /opt/forecast/.env
#   $EDITOR /opt/forecast/.env
#
# This file is a template and belongs in git. The file it becomes does NOT —
# it holds a database password and the key every stored connector credential
# is encrypted with. /opt/forecast/.env is never committed, never baked into
# an image, and never passed on a docker command line where `ps` can read it.

# ---- where the data lives -------------------------------------------------
# The connection string from Supabase → Project Settings → Database →
# Connection string → URI. The pooled host is supported and detected: the
# platform turns off server-side statement caching for it, because pgbouncer
# in transaction mode cannot carry a prepared statement between statements.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres

# Not used by this backend. The API talks to Postgres directly over the DSN
# above and never goes through PostgREST, so there is no anon key to set.
# Left here only so its absence does not look like an omission.
# SUPABASE_ANON_KEY=

# ---- archiving the uploads ------------------------------------------------
# A bucket that finished uploads are copied into. An upload is the customer's
# original spreadsheet and the only artifact that cannot be rebuilt — the
# Parquet a run reads and the exports it renders both come from it. This copies
# that one file somewhere the instance's lifetime does not bound; it does not
# move the read path, which stays on local disk so the 60-second run budget is
# not spent on transfers.
#
# Leave STORAGE_BUCKET empty and the copy is skipped entirely, which is the
# default. Spoken over S3, so any S3-compatible endpoint works.
STORAGE_BUCKET=file
STORAGE_ENDPOINT=https://YOUR-PROJECT-REF.storage.supabase.co/storage/v1/s3
STORAGE_REGION=ap-south-1

# From Supabase: Project Settings -> Storage -> S3 access keys. Deliberately
# not the service role key — that one bypasses row-level security across the
# whole database, where this needs only "may write one bucket".
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ---- refusing to guess ----------------------------------------------------
# Must stay false. APP_ENV=production plus DATABASE_FALLBACK_ENABLED=true is
# rejected by config.py and the API will not boot — deliberately. With the
# fallback on, a Supabase outage would silently divert writes to a local node
# that nothing reads, and the first symptom would be two sets of numbers that
# disagree. Failing the boot is the better failure.
DATABASE_FALLBACK_ENABLED=false

# ---- secrets --------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Every connector credential in the database is encrypted with this. Changing
# it later does not re-encrypt them — they simply stop decrypting. Set it once.
CREDENTIAL_SECRET_KEY=

# ---- runtime --------------------------------------------------------------
# One pool worker per vCPU. On the recommended t4g.small leave this at 2: the
# fit stage has a 28-second budget and a single worker will miss it.
FORECAST_WORKERS=2

# Seeding writes a demo dataset and runs a real forecast, which is what makes
# the dashboard look like a product on first load. Against a Supabase project
# you intend to keep, leave this false — you do not want demo rows in the
# store of record. Set it true once on a throwaway project if you want the
# populated dashboard to look at.
RUN_SEED_ON_STARTUP=false

LOG_LEVEL=INFO

# ---- metrics ---------------------------------------------------------------
# /api/health/metrics serves request rates and latency per route, cache hit
# ratios, circuit breaker states and forecast run outcomes, in the text format
# a Prometheus scrape reads.
#
# The token is not optional here even though the field can be left blank: this
# is a production deployment, so an empty token means every scrape is refused
# and nothing is collected. The boot log says so once. Generate one with:
#
#     openssl rand -hex 32
#
# Then point the scraper at it with `Authorization: Bearer <the token>`.
METRICS_ENABLED=true
METRICS_TOKEN=

# What the API advertises as its version, and what is mixed into every cache
# validator. Set it to the release being deployed and each one invalidates
# browsers' stored copies exactly once.
APP_VERSION=0.1.0

# ---- only when running without Supabase -----------------------------------
# Used by the `localdb` compose profile. Ignored otherwise.
# POSTGRES_USER=forecasting
# POSTGRES_PASSWORD=
# POSTGRES_DB=forecasting

# ---- sign-in ---------------------------------------------------------------
# Off until Supabase Google sign-in is proven to work in a browser. Turning it
# on before that locks everyone out of a working deployment, and the only way
# back is a shell on this box.
AUTH_ENABLED=false
AUTH_REQUIRE_APPROVAL=true
# Told when somebody new signs in, and approved on sight themselves.
AUTH_ADMIN_EMAILS=
# Empty means any Google account may ask for access.
AUTH_ALLOWED_EMAIL_DOMAINS=
# Required when the Supabase project signs its tokens with HS256. Settings ->
# API -> JWT Settings. Projects that publish a key set instead need nothing.
SUPABASE_JWT_SECRET=
# Where the approve/reject links in the email point. The public site address,
# so the link is HTTPS and reachable from a phone.
PUBLIC_API_BASE_URL=

# ---- approval email --------------------------------------------------------
# Plain SMTP: a free Gmail app password, Brevo, Resend, anything.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---- secrets ---------------------------------------------------------------
# Set these four and every value above is read from Infisical instead. They
# stay here because they are the credential that opens it.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
