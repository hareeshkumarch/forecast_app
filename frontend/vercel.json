{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": ".next",
  "regions": ["bom1"],
  "build": {
    "env": {
      "NEXT_PUBLIC_API_BASE_URL": ""
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://d2ejx9v96hubf8.cloudfront.net/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://d2ejx9v96hubf8.cloudfront.net/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://d2ejx9v96hubf8.cloudfront.net/openapi.json"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
